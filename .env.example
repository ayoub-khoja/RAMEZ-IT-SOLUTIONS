# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# En ligne (Vercel, etc.), ajoutez les mêmes variables dans les réglages du projet.

# ---- Base de données (messages et devis de l'espace /admin) ----
# Adresse PostgreSQL, par exemple depuis https://neon.tech (gratuit)
DATABASE_URL=

# ---- Espace admin ----
# Mot de passe pour se connecter sur /admin (choisissez-en un long)
ADMIN_PASSWORD=
# Clé secrète de 32 caractères ou plus (au hasard), sert à sécuriser la connexion
ADMIN_SESSION_SECRET=

# ---- E-mails (facultatif) ----
# Clé API Resend (gratuit) : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse qui reçoit les notifications
CONTACT_TO_EMAIL=ramez.it.solutions@gmail.com
# Expéditeur. Gardez onboarding@resend.dev tant que votre domaine n'est pas vérifié sur Resend.
CONTACT_FROM_EMAIL=RAMEZ IT Solutions <onboarding@resend.dev>
